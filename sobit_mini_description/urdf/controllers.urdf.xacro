<?xml version="1.0" encoding="UTF-8" ?>
<!-- SOBIT MINI (Dynamixel Control) -->
<robot name="sobit_mini_controllers" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="controllers" params="name enable_gz:=False robot_name:=sobit_mini">

    <ros2_control name="${name}_arm" type="system">
    <!-- <ros2_control name="joints_control" type="system"> -->
      <hardware>
        <xacro:if value="${$(arg enable_gz)}">
          <plugin>ign_ros2_control/IgnitionSystem</plugin>
          <!-- <plugin>gazebo_ros2_control/GazeboHardware</plugin> -->
        </xacro:if>
        <xacro:unless value="${$(arg enable_gz)}">
          <plugin>dynamixel_hardware/DynamixelHardware</plugin>
          <param name="usb_port">/dev/ttyUSB1</param>
          <param name="baud_rate">1000000</param>
          <!-- <param name="use_dummy">true</param> -->
        </xacro:unless>
      </hardware>

      <!-- Position Drive: Arm -->
      <joint name="r_arm_shoulder_roll_joint">
        <param name="id">21</param>
        <command_interface name="position">
          <param name="min">-1.57</param>
          <param name="max">3.14</param>  <!-- 1.57 -->
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>  
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="r_arm_shoulder_pan_joint">
        <param name="id">22</param>
        <command_interface name="position">
          <param name="min">-1.22</param>
          <param name="max">1.57</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">1.25</param>
        </state_interface>  
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="r_arm_elbow_tilt_joint">
        <param name="id">23</param>
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.57</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>  
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="r_arm_wrist_tilt_joint">
        <param name="id">24</param>
        <command_interface name="position">
          <param name="min">-1.57</param>
          <param name="max">1.57</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>  
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="l_arm_shoulder_roll_joint">
        <param name="id">11</param>
        <command_interface name="position">
          <param name="min">-3.14</param>
          <param name="max">1.57</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>  
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="l_arm_shoulder_pan_joint">
        <param name="id">12</param>
        <command_interface name="position">
          <param name="min">-1.57</param>
          <param name="max">1.22</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">-1.25</param>
        </state_interface>  
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="l_arm_elbow_tilt_joint">
        <param name="id">13</param>
        <command_interface name="position">
          <param name="min">-1.57</param>
          <param name="max">0.0</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>  
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="l_arm_wrist_tilt_joint">
        <param name="id">14</param>
        <command_interface name="position">
          <param name="min">-1.57</param>
          <param name="max">1.57</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>  
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Position Drive: Hand -->
      <joint name="r_hand_joint">
        <param name="id">25</param>
        <command_interface name="position">
          <param name="min">0.0</param>
          <param name="max">1.57</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>  
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="l_hand_joint">
        <param name="id">15</param>
        <command_interface name="position">
          <param name="min">-1.57</param>
          <param name="max">0.0</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>  
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Position Drive: Head -->
      <joint name="head_camera_pan_joint">
        <param name="id">3</param>
        <command_interface name="position">
          <param name="min">-1.57</param>
          <param name="max">1.57</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="head_camera_tilt_joint">
        <param name="id">4</param>
        <command_interface name="position">
          <param name="min">-0.45</param>
          <param name="max">0.45</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>

      <!-- Position Drive: Body -->
      <joint name="body_roll_joint">
        <param name="id">2</param>
        <command_interface name="position">
          <param name="min">-4.14</param>
          <param name="max">4.14</param>
        </command_interface>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>

    <!-- Differential Drive -->
    <xacro:if value="${$(arg enable_gz)}">
      <ros2_control name="${name}_base" type="system">
        <hardware>
          <plugin>ign_ros2_control/IgnitionSystem</plugin>
          <!-- <plugin>gazebo_ros2_control/GazeboHardware</plugin> -->
        </hardware>

        <joint name="wheel_l_joint">
          <command_interface name="velocity">
            <param name="min">-1.0</param>
            <param name="max">1.0</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        
        <joint name="wheel_r_joint">
          <command_interface name="velocity">
            <param name="min">-1.0</param>
            <param name="max">1.0</param>
          </command_interface>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>

      <gazebo reference="plate_bottom_link">
        <mu1>0.0</mu1>
        <mu2>0.0</mu2>
      </gazebo>
    </xacro:if>


    <!-- Ignition ROS2 Control -->
    <xacro:if value="${$(arg enable_gz)}">
      <gazebo>
        <!-- <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"> -->
        <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
          <ros>
            <namespace>${robot_name}</namespace>
          </ros>
          <parameters>$(find sobit_mini_control)/config/controllers_gz.yaml</parameters>
        </plugin>
      </gazebo>
    </xacro:if>

  </xacro:macro>

</robot>