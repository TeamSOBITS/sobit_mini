<?xml version="1.0" encoding="UTF-8" ?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="left_arm_gaebo" params="prefix">
    <xacro:left_arm_transmission prefix="${prefix}"/>
    <gazebo reference="${prefix}_shoulder_fixed_link">
      <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="${prefix}_shoulder_roll_link">
      <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="${prefix}_shoulder_pan_link">
      <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="${prefix}_elbow_tilt_link">
      <material>Gazebo/Black</material>
    </gazebo>
    <gazebo reference="${prefix}_wrist_tilt_link">
      <material>Gazebo/Black</material>
    </gazebo>
    <gazebo>
      <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
        <jointName>left_arm_shoulder_roll_joint, left_arm_shoulder_pan_joint, left_arm_elbow_tilt_joint, left_arm_wrist_tilt_joint</jointName>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>